/// Regional managers see only the stores in their region.
role 'Regional Manager'
	modelPermission: read

	tablePermission Store = Store[Region] = "Northern Reach"

	member manager.north@apothecary.example
		memberType: user

	member auditor@apothecary.example
		memberType: user

